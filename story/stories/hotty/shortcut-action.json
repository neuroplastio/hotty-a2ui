{
  "name": "HottyShortcut runs an Action",
  "description": "Control+r asks the agent to refresh, with no Button: the HottyShortcut's own action.",
  "messages": [
    {
      "version": "v1.0",
      "createSurface": {
        "surfaceId": "inbox",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
        "sendDataModel": true,
        "dataModel": {
          "filter": "unread",
          "shown": 3
        }
      }
    },
    {
      "version": "v1.0",
      "updateComponents": {
        "surfaceId": "inbox",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": [
              "title",
              "count",
              "filter",
              "help",
              "refresh_key"
            ]
          },
          {
            "id": "title",
            "component": "Text",
            "text": "## Inbox"
          },
          {
            "id": "count",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "${/shown} messages shown"
              }
            }
          },
          {
            "id": "filter",
            "component": "ChoicePicker",
            "label": "Show",
            "value": [
              "unread"
            ],
            "displayStyle": "chips",
            "options": [
              {
                "label": "Unread",
                "value": "unread"
              },
              {
                "label": "All",
                "value": "all"
              }
            ]
          },
          {
            "id": "help",
            "component": "Text",
            "text": "Control+r refreshes.",
            "variant": "caption"
          },
          {
            "id": "refresh_key",
            "component": "HottyShortcut",
            "catalogId": "https://neuroplast.io/hotty/a2ui/v1/catalog.json",
            "key": "Control+r",
            "label": "Refresh",
            "action": {
              "event": {
                "name": "refresh",
                "context": {
                  "shown": {
                    "@path": "/shown"
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
