    {
      "version": "v1.0",
      "updateComponents": {
        "surfaceId": "paginator",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": [
              "fruit_title",
              "fruit",
              "results_title",
              "results",
              "results_bar",
              "help"
            ]
          },
          {
            "id": "fruit_title",
            "component": "Text",
            "text": "#### Fruit"
          },
          {
            "id": "fruit",
            "component": "HottyPaginator",
            "catalogId": "https://hotty.neuroplast.io/a2ui/v1/catalog",
            "child": "fruit_list",
            "perPage": 4,
            "page": {
              "@path": "/fruitPage"
            },
            "accessibility": {
              "label": "Fruit pages"
            }
          },
          {
            "id": "fruit_list",
            "component": "List",
            "children": {
              "componentId": "fruit_item",
              "path": "/fruit"
            }
          },
          {
            "id": "fruit_item",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "- ${name}"
              }
            }
          },
          {
            "id": "results_title",
            "component": "Text",
            "text": "#### Search results"
          },
          {
            "id": "results",
            "component": "List",
            "children": {
              "componentId": "result",
              "path": "/results/items"
            }
          },
          {
            "id": "result",
            "component": "Column",
            "children": [
              "result_title",
              "result_url"
            ]
          },
          {
            "id": "result_title",
            "component": "Text",
            "text": {
              "@path": "title"
            }
          },
          {
            "id": "result_url",
            "component": "Text",
            "text": {
              "@path": "url"
            },
            "variant": "caption"
          },
          {
            "id": "results_bar",
            "component": "Row",
            "justify": "spaceBetween",
            "align": "center",
            "children": [
              "results_count",
              "results_pager"
            ]
          },
          {
            "id": "results_count",
            "component": "Text",
            "text": "58 results",
            "variant": "caption"
          },
          {
            "id": "results_pager",
            "component": "HottyPaginator",
            "catalogId": "https://hotty.neuroplast.io/a2ui/v1/catalog",
            "pages": {
              "@path": "/results/pages"
            },
            "page": {
              "@path": "/results/page"
            },
            "displayStyle": "numbers",
            "accessibility": {
              "label": "Result pages"
            },
            "onChange": {
              "event": {
                "name": "search",
                "context": {
                  "query": {
                    "@path": "/results/query"
                  },
                  "page": {
                    "@path": "/results/page"
                  }
                }
              }
            }
          },
          {
            "id": "help",
            "component": "HottyKeyHints",
            "catalogId": "https://hotty.neuroplast.io/a2ui/v1/catalog"
          }
        ]
      }
    }
  ]
