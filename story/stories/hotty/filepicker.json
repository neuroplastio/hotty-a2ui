{
  "name": "File picker",
  "kind": "component",
  "component": "HottyFilePicker",
  "icon": "folder",
  "description": "Bubbles' filepicker: browse a program-granted root directory. Arrow keys, j and k move the selection; Enter, l and ArrowRight open a directory or pick a file; Backspace, h, Escape and ArrowLeft go to the parent directory. Picking a file writes its path to /selected and triggers onPick.",
  "messages": [
    {
      "version": "v1.0",
      "createSurface": {
        "surfaceId": "picker",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
        "dataModel": {
          "dir": "",
          "picked": ""
        }
      }
    },
    {
      "version": "v1.0",
      "updateComponents": {
        "surfaceId": "picker",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": [
              "picker_card",
              "status_text"
            ]
          },
          {
            "id": "picker_card",
            "component": "Card",
            "child": "fp"
          },
          {
            "id": "fp",
            "component": "HottyFilePicker",
            "catalogId": "https://hotty.neuroplast.io/a2ui/v1/catalog",
            "root": "project",
            "path": {
              "@path": "/dir"
            },
            "selected": {
              "@path": "/picked"
            },
            "height": 6,
            "onPick": {
              "event": {
                "name": "filePicked",
                "context": {
                  "file": {
                    "@path": "/picked"
                  }
                }
              }
            },
            "onChange": {
              "event": {
                "name": "dirChanged",
                "context": {
                  "dir": {
                    "@path": "/dir"
                  }
                }
              }
            }
          },
          {
            "id": "status_text",
            "component": "Text",
            "text": {
              "@path": "/picked"
            }
          }
        ]
      }
    }
  ]
}
