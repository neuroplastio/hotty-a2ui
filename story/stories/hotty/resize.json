{
  "name": "Resizable text",
  "kind": "behaviour",
  "component": "TextField (longText)",
  "icon": "open_in_full",
  "description": "A longText resizes from its corner, as a web textarea does: drag the grip (◢ in cells, the host's corner on a hotty host). The resize extension says along which axes: both, the default, vertical, horizontal or none.",
  "messages": [
    {
      "version": "v1.0",
      "createSurface": {
        "surfaceId": "notes",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
        "dataModel": {
          "both": "Drag the corner either way.",
          "vertical": "Taller or shorter only.",
          "horizontal": "Wider or narrower only.",
          "none": "A fixed size."
        }
      }
    },
    {
      "version": "v1.0",
      "updateComponents": {
        "surfaceId": "notes",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": [
              "both",
              "vertical",
              "horizontal",
              "none"
            ]
          },
          {
            "id": "both",
            "component": "TextField",
            "label": "Both (the default)",
            "variant": "longText",
            "value": {
              "@path": "/both"
            }
          },
          {
            "id": "vertical",
            "component": "TextField",
            "label": "Vertical",
            "variant": "longText",
            "value": {
              "@path": "/vertical"
            },
            "metadata": {
              "extensions": {
                "io_neuroplast_hotty": {
                  "resize": "vertical"
                }
              }
            }
          },
          {
            "id": "horizontal",
            "component": "TextField",
            "label": "Horizontal",
            "variant": "longText",
            "value": {
              "@path": "/horizontal"
            },
            "metadata": {
              "extensions": {
                "io_neuroplast_hotty": {
                  "resize": "horizontal"
                }
              }
            }
          },
          {
            "id": "none",
            "component": "TextField",
            "label": "None",
            "variant": "longText",
            "value": {
              "@path": "/none"
            },
            "metadata": {
              "extensions": {
                "io_neuroplast_hotty": {
                  "resize": "none"
                }
              }
            }
          }
        ]
      }
    }
  ]
}
