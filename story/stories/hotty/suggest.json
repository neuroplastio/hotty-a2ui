    {
      "version": "v1.0",
      "updateComponents": {
        "surfaceId": "suggest",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": [
              "form",
              "hints"
            ]
          },
          {
            "id": "form",
            "component": "HottyForm",
            "catalogId": "https://hotty.neuroplast.io/a2ui/v1/catalog",
            "child": "fields",
            "onSubmit": {
              "event": {
                "name": "go",
                "context": {
                  "command": {
                    "@path": "/command"
                  },
                  "country": {
                    "@path": "/country"
                  },
                  "city": {
                    "@path": "/city"
                  }
                }
              }
            }
          },
          {
            "id": "fields",
            "component": "Column",
            "children": [
              "heading",
              "command",
              "country",
              "city"
            ]
          },
          {
            "id": "heading",
            "component": "Text",
            "text": "## Run a command"
          },
          {
            "id": "command",
            "component": "TextField",
            "label": "Command",
            "placeholder": "git …",
            "value": {
              "@path": "/command"
            },
            "metadata": {
              "extensions": {
                "io_neuroplast_hotty": {
                  "autofocus": true,
                  "suggestions": {
                    "options": {
                      "@path": "/commands"
                    }
                  }
                }
              }
            }
          },
          {
            "id": "country",
            "component": "TextField",
            "label": "Country",
            "placeholder": "Start typing a country",
            "value": {
              "@path": "/country"
            },
            "metadata": {
              "extensions": {
                "io_neuroplast_hotty": {
                  "suggestions": {
                    "options": {
                      "@path": "/countries"
                    },
                    "onInput": {
                      "event": {
                        "name": "suggest",
                        "context": {
                          "query": {
                            "@path": "/country"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "id": "city",
            "component": "TextField",
            "label": "City",
            "value": {
              "@path": "/city"
            },
            "metadata": {
              "extensions": {
                "io_neuroplast_hotty": {
                  "suggestions": {
                    "options": {
                      "@path": "/cities"
                    }
                  }
                }
              }
            }
          },
          {
            "id": "hints",
            "component": "HottyKeyHints",
            "catalogId": "https://hotty.neuroplast.io/a2ui/v1/catalog"
