{
  "name": "hottyFocus and hottyBlur",
  "description": "The name field takes the keyboard when the surface shows (autofocus). The buttons move it with the hottyFocus and hottyBlur functions: on a host, a=focus and a=blur.",
  "messages": [
    {
      "version": "v1.0",
      "createSurface": {
        "surfaceId": "profile",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
        "sendDataModel": true,
        "dataModel": {
          "name": "",
          "city": ""
        }
      }
    },
    {
      "version": "v1.0",
      "updateComponents": {
        "surfaceId": "profile",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": [
              "title",
              "name",
              "city",
              "buttons"
            ]
          },
          {
            "id": "title",
            "component": "Text",
            "text": "## Profile"
          },
          {
            "id": "name",
            "component": "TextField",
            "label": "Name",
            "value": {
              "@path": "/name"
            },
            "metadata": {
              "extensions": {
                "io_neuroplast_hotty": {
                  "autofocus": true
                }
              }
            }
          },
          {
            "id": "city",
            "component": "TextField",
            "label": "City",
            "value": {
              "@path": "/city"
            }
          },
          {
            "id": "buttons",
            "component": "Row",
            "children": [
              "to_city",
              "done"
            ]
          },
          {
            "id": "to_city",
            "component": "Button",
            "child": "to_city_t",
            "action": {
              "functionCall": {
                "@call": "hottyFocus",
                "catalogId": "https://neuroplast.io/hotty/a2ui/v1/catalog.json",
                "args": {
                  "id": "city"
                }
              }
            }
          },
          {
            "id": "to_city_t",
            "component": "Text",
            "text": "Go to City"
          },
          {
            "id": "done",
            "component": "Button",
            "child": "done_t",
            "action": {
              "functionCall": {
                "@call": "hottyBlur",
                "catalogId": "https://neuroplast.io/hotty/a2ui/v1/catalog.json"
              }
            }
          },
          {
            "id": "done_t",
            "component": "Text",
            "text": "Done"
          }
        ]
      }
    }
  ]
}
