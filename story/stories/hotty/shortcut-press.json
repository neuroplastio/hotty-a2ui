{
  "name": "Shortcut presses a button",
  "kind": "behaviour",
  "component": "HottyShortcut",
  "icon": "ads_click",
  "description": "Control+s presses Save, as a click would, and only when Save's checks pass. It works from the field too: the field commits first.",
  "messages": [
    {
      "version": "v1.0",
      "createSurface": {
        "surfaceId": "note",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
        "sendDataModel": true,
        "dataModel": {
          "note": ""
        }
      }
    },
    {
      "version": "v1.0",
      "updateComponents": {
        "surfaceId": "note",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": [
              "title",
              "note",
              "save",
              "help",
              "save_key"
            ]
          },
          {
            "id": "title",
            "component": "Text",
            "text": "## A note"
          },
          {
            "id": "note",
            "component": "TextField",
            "label": "Note",
            "value": {
              "@path": "/note"
            },
            "variant": "longText"
          },
          {
            "id": "save",
            "component": "Button",
            "child": "save_t",
            "action": {
              "event": {
                "name": "save",
                "context": {
                  "note": {
                    "@path": "/note"
                  }
                }
              }
            },
            "variant": "primary",
            "checks": [
              {
                "condition": {
                  "@call": "required",
                  "args": {
                    "value": {
                      "@path": "/note"
                    }
                  }
                },
                "message": "Write something first"
              }
            ]
          },
          {
            "id": "save_t",
            "component": "Text",
            "text": "Save"
          },
          {
            "id": "help",
            "component": "Text",
            "text": "Control+s saves.",
            "variant": "caption"
          },
          {
            "id": "save_key",
            "component": "HottyShortcut",
            "catalogId": "https://hotty.neuroplast.io/a2ui/v1/catalog",
            "key": "Control+s",
            "press": "save",
            "label": "Save"
          }
        ]
      }
    }
  ]
}
