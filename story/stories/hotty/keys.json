{
  "name": "Text fields' keys",
  "description": "A field edits by its keymap (HOTTY SPEC §10.2): the Keys picker sets the surface's, Terminal (Bubble Tea's keys: Control+a, Alt+b, Control+w…) or Default (the arrows, Home, End, Backspace, Delete). In Notes, up and down keep their place along the row. The password is one word. The HottyForm binds Control+s to submit and leaves Control+k to the program, whose HottyShortcut takes it; in Notes, Control+k deletes to the line's end.",
  "messages": [
    {
      "version": "v1.0",
      "createSurface": {
        "surfaceId": "keys",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
        "sendDataModel": true,
        "dataModel": {
          "notes": "A short line\nA much longer line, to come back along\nshort\nAnd another long line to finish on",
          "password": "correct horse battery staple",
          "message": "Hello there"
        }
      }
    },
    {
      "version": "v1.0",
      "updateComponents": {
        "surfaceId": "keys",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": [
              "notes",
              "password",
              "form",
              "program_key"
            ]
          },
          {
            "id": "notes",
            "component": "TextField",
            "label": "Notes",
            "variant": "longText",
            "value": {
              "@path": "/notes"
            }
          },
          {
            "id": "password",
            "component": "TextField",
            "label": "Password",
            "variant": "obscured",
            "value": {
              "@path": "/password"
            }
          },
          {
            "id": "form",
            "component": "HottyForm",
            "catalogId": "https://neuroplast.io/hotty/a2ui/v1/catalog.json",
            "child": "form_fields",
            "onSubmit": {
              "event": {
                "name": "send",
                "context": {
                  "message": {
                    "@path": "/message"
                  }
                }
              }
            },
            "metadata": {
              "extensions": {
                "io_neuroplast_hotty": {
                  "keys": "Control+s=submit Control+k=program"
                }
              }
            }
          },
          {
            "id": "form_fields",
            "component": "Column",
            "children": [
              "message",
              "form_help"
            ]
          },
          {
            "id": "message",
            "component": "TextField",
            "label": "Message",
            "value": {
              "@path": "/message"
            }
          },
          {
            "id": "form_help",
            "component": "Text",
            "text": "Here Control+s sends, and Control+k is the program's.",
            "variant": "caption"
          },
          {
            "id": "program_key",
            "component": "HottyShortcut",
            "catalogId": "https://neuroplast.io/hotty/a2ui/v1/catalog.json",
            "key": "Control+k",
            "label": "Control+k",
            "action": {
              "event": {
                "name": "controlK",
                "context": {
                  "message": {
                    "@path": "/message"
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
