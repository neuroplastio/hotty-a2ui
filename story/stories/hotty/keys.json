{
  "name": "Text field keys",
  "kind": "behaviour",
  "component": "io_neuroplast_hotty.keys",
  "icon": "keyboard",
  "description": "A field edits by its keymap (hotty SPEC §10.2), here the default one: the arrows, by words with Alt or Control, Home, End, Backspace, Delete, and on a Mac Command with the arrows to the ends and Cocoa's Control keys (ctrl+e, ctrl+k…). Shift with a move selects, and ctrl+a (Command+a on a Mac) selects all, as in a GUI's field. In Notes, up and down keep their place along the row. The password is one word. The HottyForm binds ctrl+s to submit and leaves ctrl+k to the program, whose HottyShortcut takes it.",
  "messages": [
    {
      "version": "v1.0",
      "createSurface": {
        "surfaceId": "keys",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
        "sendDataModel": true,
        "dataModel": {
          "notes": "A short line\nA much longer line, to come back along\nshort\nAnd another long line to finish on",
          "password": "correct horse battery staple",
          "message": "Hello there"
        }
      }
    },
    {
      "version": "v1.0",
      "updateComponents": {
        "surfaceId": "keys",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": [
              "notes",
              "password",
              "form",
              "program_key"
            ]
          },
          {
            "id": "notes",
            "component": "TextField",
            "label": "Notes",
            "variant": "longText",
            "value": {
              "@path": "/notes"
            }
          },
          {
            "id": "password",
            "component": "TextField",
            "label": "Password",
            "variant": "obscured",
            "value": {
              "@path": "/password"
            }
          },
          {
            "id": "form",
            "component": "HottyForm",
            "catalogId": "https://hotty.neuroplast.io/a2ui/v1/catalog",
            "child": "form_fields",
            "onSubmit": {
              "event": {
                "name": "send",
                "context": {
                  "message": {
                    "@path": "/message"
                  }
                }
              }
            },
            "metadata": {
              "extensions": {
                "io_neuroplast_hotty": {
                  "keys": "ctrl+s=submit ctrl+k=program"
                }
              }
            }
          },
          {
            "id": "form_fields",
            "component": "Column",
            "children": [
              "message",
              "form_help"
            ]
          },
          {
            "id": "message",
            "component": "TextField",
            "label": "Message",
            "value": {
              "@path": "/message"
            }
          },
          {
            "id": "form_help",
            "component": "Text",
            "text": "Here ctrl+s sends, and ctrl+k is the program's.",
            "variant": "caption"
          },
          {
            "id": "program_key",
            "component": "HottyShortcut",
            "catalogId": "https://hotty.neuroplast.io/a2ui/v1/catalog",
            "key": "ctrl+k",
            "label": "ctrl+k",
            "action": {
              "event": {
                "name": "controlK",
                "context": {
                  "message": {
                    "@path": "/message"
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
