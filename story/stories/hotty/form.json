{
  "name": "HottyForm submits on Enter",
  "description": "Enter in any field submits the HottyForm: its onSubmit runs once every check inside passes, and until then the failing ones show.",
  "messages": [
    {
      "version": "v1.0",
      "createSurface": {
        "surfaceId": "signup",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
        "sendDataModel": true,
        "dataModel": {
          "name": "",
          "email": "",
          "plan": [
            "free"
          ],
          "agree": false
        }
      }
    },
    {
      "version": "v1.0",
      "updateComponents": {
        "surfaceId": "signup",
        "components": [
          {
            "id": "root",
            "component": "HottyForm",
            "catalogId": "https://neuroplast.io/hotty/a2ui/v1/catalog.json",
            "child": "fields",
            "onSubmit": {
              "event": {
                "name": "signUp",
                "context": {
                  "name": {
                    "@path": "/name"
                  },
                  "email": {
                    "@path": "/email"
                  },
                  "plan": {
                    "@path": "/plan"
                  }
                }
              }
            },
            "checks": [
              {
                "condition": {
                  "@path": "/agree"
                },
                "message": "Accept the terms to sign up"
              }
            ]
          },
          {
            "id": "fields",
            "component": "Column",
            "children": [
              "title",
              "name",
              "email",
              "plan",
              "agree",
              "help"
            ]
          },
          {
            "id": "title",
            "component": "Text",
            "text": "## Sign up"
          },
          {
            "id": "name",
            "component": "TextField",
            "label": "Name",
            "value": {
              "@path": "/name"
            },
            "checks": [
              {
                "condition": {
                  "@call": "required",
                  "args": {
                    "value": {
                      "@path": "/name"
                    }
                  }
                },
                "message": "Your name, please"
              }
            ]
          },
          {
            "id": "email",
            "component": "TextField",
            "label": "Email",
            "value": {
              "@path": "/email"
            },
            "checks": [
              {
                "condition": {
                  "@call": "email",
                  "args": {
                    "value": {
                      "@path": "/email"
                    }
                  }
                },
                "message": "An email address, please"
              }
            ]
          },
          {
            "id": "plan",
            "component": "ChoicePicker",
            "label": "Plan",
            "value": {
              "@path": "/plan"
            },
            "options": [
              {
                "label": "Free",
                "value": "free"
              },
              {
                "label": "Pro",
                "value": "pro"
              }
            ]
          },
          {
            "id": "agree",
            "component": "CheckBox",
            "label": "I accept the terms",
            "value": {
              "@path": "/agree"
            }
          },
          {
            "id": "help",
            "component": "Text",
            "text": "Enter in a field signs you up.",
            "variant": "caption"
          }
        ]
      }
    }
  ]
}
